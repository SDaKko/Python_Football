@prefix : <http://example.org/football-ise/> .
@prefix ex: <http://example.org/football-ise/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/football-ise/> .

<http://example.org/football-ise/> rdf:type owl:Ontology ;
                                    rdfs:comment "Модель наблюдения -> оценки -> решения -> исполнения -> исхода, с контекстом матча и ограничениями правил."@ru ;
                                    rdfs:label "Оценивание игроками ситуации при игре в футбол"@ru .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/football-ise/basedOnEvaluation
ex:basedOnEvaluation rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain ex:Decision ;
                     rdfs:range ex:SituationEvaluation ;
                     rdfs:comment "Решение принимается на основе оценки ситуации"@ru ,
                                  "основано на оценке"@ru .


###  http://example.org/football-ise/belongsToTeam
ex:belongsToTeam rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain ex:Player ;
                 rdfs:range ex:Team ;
                 rdfs:comment "принадлежит команде"@ru .


###  http://example.org/football-ise/chosenOption
ex:chosenOption rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ex:Decision ;
                rdfs:range ex:ActionOption ;
                rdfs:comment "Функциональное свойство: в один момент выбран ровно один вариант."@ru ,
                             "выбранный вариант"@ru .


###  http://example.org/football-ise/considersOptions
ex:considersOptions rdf:type owl:ObjectProperty ,
                             owl:AsymmetricProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain ex:SituationEvaluation ;
                    rdfs:range ex:ActionOption ;
                    rdfs:comment "Оценка ситуации включает анализ доступных вариантов действий"@ru ,
                                 "рассматривает варианты"@ru .


###  http://example.org/football-ise/considersPressure
ex:considersPressure rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain ex:SituationEvaluation ;
                     rdfs:range ex:PressureLevel ;
                     rdfs:comment "учитывает давление"@ru .


###  http://example.org/football-ise/considersSpace
ex:considersSpace rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain ex:SituationEvaluation ;
                  rdfs:range ex:SpaceAvailability ;
                  rdfs:comment "учитывает пространство"@ru .


###  http://example.org/football-ise/executes
ex:executes rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain ex:Decision ;
            rdfs:range ex:ActionExecution ;
            rdfs:comment "реализует (исполнение)"@ru .


###  http://example.org/football-ise/hasActionType
ex:hasActionType rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain ex:ActionOption ;
                 rdfs:range ex:ActionType ;
                 rdfs:comment "имеет тип действия"@ru .


###  http://example.org/football-ise/hasConstraintType
ex:hasConstraintType rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain ex:Constraint ;
                     rdfs:range ex:ConstraintType ;
                     rdfs:comment "имеет тип ограничения"@ru .


###  http://example.org/football-ise/hasContext
ex:hasContext rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain ex:Situation ;
              rdfs:range ex:Context ;
              rdfs:comment "имеет контекст"@ru .


###  http://example.org/football-ise/hasOutcome
ex:hasOutcome rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain ex:ActionExecution ;
              rdfs:range ex:Outcome ;
              rdfs:comment "имеет исход"@ru .


###  http://example.org/football-ise/hasPhase
ex:hasPhase rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ,
                     owl:AsymmetricProperty ,
                     owl:IrreflexiveProperty ;
            rdfs:domain ex:Situation ;
            rdfs:range ex:Phase ;
            rdfs:comment "находится в фазе"@ru .


###  http://example.org/football-ise/influence
ex:influence rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain ex:CoachInstructions ;
             rdfs:range ex:Decision ;
             rdfs:comment "influence" .


###  http://example.org/football-ise/influences
ex:influences rdf:type owl:ObjectProperty ,
                       owl:AsymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain ex:Context ;
              rdfs:range ex:Decision ;
              rdfs:comment "influences" .


###  http://example.org/football-ise/involvesPlayer
ex:involvesPlayer rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain ex:Player ;
                  rdfs:range ex:Situation ;
                  rdfs:comment "участвует в"@ru .


###  http://example.org/football-ise/isCharacterizedBy
ex:isCharacterizedBy rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain ex:Situation ;
                     rdfs:range ex:SituationEvaluation ;
                     rdfs:comment "Characterized by" .


###  http://example.org/football-ise/limitedBy
ex:limitedBy rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain ex:ActionOption ;
             rdfs:range ex:Constraint ;
             rdfs:comment "ограничено правилом"@ru .


###  http://example.org/football-ise/madeByPlayer
ex:madeByPlayer rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ex:Player ;
                rdfs:range ex:Decision ;
                rdfs:comment "Принимает решение"@ru .


###  http://example.org/football-ise/occursInZone
ex:occursInZone rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ex:Situation ;
                rdfs:range ex:Zone ;
                rdfs:comment "происходит в зоне"@ru .


###  http://example.org/football-ise/offersOption
ex:offersOption rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain ex:Situation ;
                rdfs:range ex:ActionOption ;
                rdfs:comment "порождает вариант"@ru .


###  http://example.org/football-ise/performedByPlayer
ex:performedByPlayer rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ,
                              owl:AsymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain ex:ActionExecution ;
                     rdfs:range ex:Player ;
                     rdfs:comment "выполнено игроком"@ru .


###  http://example.org/football-ise/subjectToConstraint
ex:subjectToConstraint rdf:type owl:ObjectProperty ,
                                owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty ;
                       rdfs:domain ex:Situation ;
                       rdfs:range ex:Constraint ;
                       rdfs:comment "Ситуация подвержена определенным ограничениям/правилам"@ru ,
                                    "подвержена ограничению"@ru .


#################################################################
#    Data properties
#################################################################

###  http://example.org/football-ise/angleToGoal
ex:angleToGoal rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain ex:SituationEvaluation ;
               rdfs:range xsd:decimal ;
               rdfs:comment "угол к воротам (градусы)"@ru .


###  http://example.org/football-ise/constraintSeverity
ex:constraintSeverity rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain ex:Constraint ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "степень влияния ограничения (0..1)"@ru .


###  http://example.org/football-ise/decisionTime
ex:decisionTime rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ex:Decision ;
                rdfs:range xsd:decimal ;
                rdfs:comment "время принятия решения (секунды)"@ru .


###  http://example.org/football-ise/distanceToNearestDefender
ex:distanceToNearestDefender rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain ex:SituationEvaluation ;
                             rdfs:range xsd:decimal ;
                             rdfs:comment "дистанция до ближайшего защитника (м)"@ru .


###  http://example.org/football-ise/expectedValue
ex:expectedValue rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain ex:SituationEvaluation ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "Абстрактная xEV — вероятностная польза/гол-эквивалент"@ru ,
                              "ожидаемая ценность действия (0..1)"@ru .


###  http://example.org/football-ise/isCounterAttack
ex:isCounterAttack rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:Context ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "контратака?"@ru .


###  http://example.org/football-ise/matchMinute
ex:matchMinute rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain ex:Context ;
               rdfs:range xsd:int ;
               rdfs:comment "минута матча"@ru .


###  http://example.org/football-ise/optionSuccessProbability
ex:optionSuccessProbability rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain ex:SituationEvaluation ;
                            rdfs:range xsd:decimal ;
                            rdfs:comment "вероятность успеха варианта (0..1)"@ru .


###  http://example.org/football-ise/playerPositionX
ex:playerPositionX rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:Player ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "позиция игрока по X"@ru .


###  http://example.org/football-ise/playerPositionY
ex:playerPositionY rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:Player ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "позиция игрока по Y"@ru .


###  http://example.org/football-ise/scoreDiff
ex:scoreDiff rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain ex:Context ;
             rdfs:range xsd:int ;
             rdfs:comment "разница в счёте (свои - чужие)"@ru .


###  http://example.org/football-ise/timePressure
ex:timePressure rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain ex:SituationEvaluation ;
                rdfs:range xsd:decimal ;
                rdfs:comment "временное давление (0..1)"@ru .


#################################################################
#    Classes
#################################################################

###  http://example.org/football-ise/ActionExecution
ex:ActionExecution rdf:type owl:Class ;
                   rdfs:comment "Исполнение действия"@ru .


###  http://example.org/football-ise/ActionOption
ex:ActionOption rdf:type owl:Class ;
                rdfs:comment "Вариант действия"@ru .


###  http://example.org/football-ise/ActionType
ex:ActionType rdf:type owl:Class ;
              rdfs:comment "Тип действия"@ru .


###  http://example.org/football-ise/ChallengingSituation
ex:ChallengingSituation rdf:type owl:Class .


###  http://example.org/football-ise/CoachInstructions
ex:CoachInstructions rdf:type owl:Class ;
                     rdfs:comment "Установки тренера" .


###  http://example.org/football-ise/Constraint
ex:Constraint rdf:type owl:Class ;
              rdfs:comment "Ограничение/правило"@ru .


###  http://example.org/football-ise/ConstraintType
ex:ConstraintType rdf:type owl:Class ;
                  rdfs:comment "Тип ограничения"@ru .


###  http://example.org/football-ise/Context
ex:Context rdf:type owl:Class ;
           rdfs:comment "Контекст матча"@ru .


###  http://example.org/football-ise/CriticalAttackingSituation
ex:CriticalAttackingSituation rdf:type owl:Class .


###  http://example.org/football-ise/Decision
ex:Decision rdf:type owl:Class ;
            rdfs:comment "Решение"@ru .


###  http://example.org/football-ise/EffectivePassingDecision
ex:EffectivePassingDecision rdf:type owl:Class .


###  http://example.org/football-ise/FoulConstrainedAction
ex:FoulConstrainedAction rdf:type owl:Class .


###  http://example.org/football-ise/HighEfficiencyDecision
ex:HighEfficiencyDecision rdf:type owl:Class .


###  http://example.org/football-ise/OffsideConstrainedAction
ex:OffsideConstrainedAction rdf:type owl:Class .


###  http://example.org/football-ise/Outcome
ex:Outcome rdf:type owl:Class ;
           rdfs:comment "Исход"@ru .


###  http://example.org/football-ise/Phase
ex:Phase rdf:type owl:Class ;
         rdfs:comment "Фаза игры"@ru .


###  http://example.org/football-ise/Player
ex:Player rdf:type owl:Class ;
          rdfs:comment "Игрок"@ru .


###  http://example.org/football-ise/PressureLevel
ex:PressureLevel rdf:type owl:Class ;
                 rdfs:comment "Уровень давления"@ru .


###  http://example.org/football-ise/PromisingSituation
ex:PromisingSituation rdf:type owl:Class .


###  http://example.org/football-ise/QuickPressureDecision
ex:QuickPressureDecision rdf:type owl:Class .


###  http://example.org/football-ise/Situation
ex:Situation rdf:type owl:Class ;
             rdfs:comment "Ситуация"@ru .


###  http://example.org/football-ise/SituationEvaluation
ex:SituationEvaluation rdf:type owl:Class ;
                       rdfs:comment "Оценка ситуации"@ru .


###  http://example.org/football-ise/SpaceAvailability
ex:SpaceAvailability rdf:type owl:Class ;
                     rdfs:comment "Свободное пространство"@ru .


###  http://example.org/football-ise/Team
ex:Team rdf:type owl:Class ;
        rdfs:comment "Команда"@ru .


###  http://example.org/football-ise/Zone
ex:Zone rdf:type owl:Class ;
        rdfs:comment "Зона поля"@ru .


#################################################################
#    Individuals
#################################################################

###  http://example.org/football-ise/AttackingThird
ex:AttackingThird rdf:type owl:NamedIndividual ,
                           ex:Zone ;
                  rdfs:label "Атакующая треть"@ru .


###  http://example.org/football-ise/BackPass
ex:BackPass rdf:type owl:NamedIndividual ,
                     ex:ActionOption ,
                     ex:FoulConstrainedAction ;
            ex:hasActionType ex:PassType ;
            ex:limitedBy ex:BackPassRule ;
            rdfs:label "Пас назад"@ru .


###  http://example.org/football-ise/BackPassRule
ex:BackPassRule rdf:type owl:NamedIndividual ,
                         ex:Constraint ;
                ex:hasConstraintType ex:FoulType ;
                ex:constraintSeverity 0.5 ;
                rdfs:label "Правило паса вратарю"@ru .


###  http://example.org/football-ise/BoundaryType
ex:BoundaryType rdf:type owl:NamedIndividual ,
                         ex:ConstraintType ;
                rdfs:label "Тип: Граница"@ru .


###  http://example.org/football-ise/BoxPressure
ex:BoxPressure rdf:type owl:NamedIndividual ,
                        ex:Phase ;
               rdfs:label "Давление у штрафной"@ru .


###  http://example.org/football-ise/BuildUp
ex:BuildUp rdf:type owl:NamedIndividual ,
                    ex:Phase ;
           rdfs:label "Построение атаки"@ru .


###  http://example.org/football-ise/CAM10
ex:CAM10 rdf:type owl:NamedIndividual ,
                  ex:Player ;
         ex:belongsToTeam ex:TeamA ;
         ex:involvesPlayer ex:Sit_2 ,
                           ex:Sit_9 ;
         ex:madeByPlayer ex:Dec_4 ;
         ex:playerPositionX 70.0 ;
         ex:playerPositionY 50.0 ;
         rdfs:label "Атакующий полузащитник #10"@ru .


###  http://example.org/football-ise/CB5
ex:CB5 rdf:type owl:NamedIndividual ,
                ex:Player ;
       ex:belongsToTeam ex:TeamA ;
       ex:involvesPlayer ex:Sit_10 ,
                         ex:Sit_7 ;
       ex:madeByPlayer ex:Dec_10 ;
       ex:playerPositionX 40.0 ;
       ex:playerPositionY 50.0 ;
       rdfs:label "Центральный защитник #5"@ru .


###  http://example.org/football-ise/CB6
ex:CB6 rdf:type owl:NamedIndividual ,
                ex:Player ;
       ex:belongsToTeam ex:TeamA ;
       ex:involvesPlayer ex:Sit_7 ;
       ex:madeByPlayer ex:Dec_10 ;
       ex:playerPositionX 40.0 ;
       ex:playerPositionY 60.0 ;
       rdfs:label "Центральный защитник #6"@ru .


###  http://example.org/football-ise/CDM4
ex:CDM4 rdf:type owl:NamedIndividual ,
                 ex:Player ;
        ex:belongsToTeam ex:TeamA ;
        ex:involvesPlayer ex:Sit_3 ,
                          ex:Sit_4 ,
                          ex:Sit_7 ;
        ex:madeByPlayer ex:Dec_7 ;
        ex:playerPositionX 55.0 ;
        ex:playerPositionY 50.0 ;
        rdfs:label "Опорный полузащитник #4"@ru .


###  http://example.org/football-ise/CM8
ex:CM8 rdf:type owl:NamedIndividual ,
                ex:Player ;
       ex:belongsToTeam ex:TeamA ;
       ex:involvesPlayer ex:Sit_2 ,
                         ex:Sit_3 ,
                         ex:Sit_4 ;
       ex:madeByPlayer ex:Dec_2 ,
                       ex:Dec_3 ;
       ex:playerPositionX 65.0 ;
       ex:playerPositionY 50.0 ;
       rdfs:label "Центр. полузащитник #8"@ru .


###  http://example.org/football-ise/CardType
ex:CardType rdf:type owl:NamedIndividual ,
                     ex:ConstraintType ;
            rdfs:label "Тип: Карточка"@ru .


###  http://example.org/football-ise/CenterCircle
ex:CenterCircle rdf:type owl:NamedIndividual ,
                         ex:Zone ;
                rdfs:label "Центральный круг"@ru .


###  http://example.org/football-ise/CenterSpot
ex:CenterSpot rdf:type owl:NamedIndividual ,
                       ex:Zone ;
              rdfs:label "Центральная точка"@ru .


###  http://example.org/football-ise/ChannelSpace
ex:ChannelSpace rdf:type owl:NamedIndividual ,
                         ex:SpaceAvailability ;
                rdfs:label "Коридор"@ru .


###  http://example.org/football-ise/ChipShot
ex:ChipShot rdf:type owl:NamedIndividual ,
                     ex:ActionOption ,
                     ex:OffsideConstrainedAction ;
            ex:hasActionType ex:ShotType ;
            ex:limitedBy ex:OffsideRule ;
            rdfs:label "Подкидка"@ru .


###  http://example.org/football-ise/Clearance
ex:Clearance rdf:type owl:NamedIndividual ,
                      ex:ActionOption ,
                      ex:FoulConstrainedAction ;
             ex:hasActionType ex:DefensiveType ;
             ex:limitedBy ex:FoulRule ;
             rdfs:label "Вынос"@ru .


###  http://example.org/football-ise/Coaching_CounterAttack
ex:Coaching_CounterAttack rdf:type owl:NamedIndividual ,
                                   ex:CoachInstructions ;
                          ex:influence ex:Dec_6 ;
                          rdfs:label "Установка: Игра на контратаку"@ru .


###  http://example.org/football-ise/Coaching_HighPress
ex:Coaching_HighPress rdf:type owl:NamedIndividual ,
                               ex:CoachInstructions ;
                      ex:influence ex:Dec_5 ;
                      rdfs:label "Установка: Высокий прессинг"@ru .


###  http://example.org/football-ise/Coaching_ManMark
ex:Coaching_ManMark rdf:type owl:NamedIndividual ,
                             ex:CoachInstructions ;
                    rdfs:label "Установка: Персональная опека"@ru .


###  http://example.org/football-ise/Coaching_PlayOutFromBack
ex:Coaching_PlayOutFromBack rdf:type owl:NamedIndividual ,
                                     ex:CoachInstructions ;
                            ex:influence ex:Dec_10 ;
                            rdfs:label "Установка: Игра от ворот"@ru .


###  http://example.org/football-ise/Coaching_PlayThroughMidfield
ex:Coaching_PlayThroughMidfield rdf:type owl:NamedIndividual ,
                                         ex:CoachInstructions ;
                                ex:influence ex:Dec_4 ;
                                rdfs:label "Установка: Игра через центр"@ru .


###  http://example.org/football-ise/Coaching_Possession
ex:Coaching_Possession rdf:type owl:NamedIndividual ,
                                ex:CoachInstructions ;
                       ex:influence ex:Dec_7 ;
                       rdfs:label "Установка: Сохранение владения"@ru .


###  http://example.org/football-ise/Coaching_ShootOnSight
ex:Coaching_ShootOnSight rdf:type owl:NamedIndividual ,
                                  ex:CoachInstructions ;
                         ex:influence ex:Dec_9 ;
                         rdfs:label "Установка: Бить при первой возможности"@ru .


###  http://example.org/football-ise/Coaching_StayCompact
ex:Coaching_StayCompact rdf:type owl:NamedIndividual ,
                                 ex:CoachInstructions ;
                        rdfs:label "Установка: Оставаться компактными"@ru .


###  http://example.org/football-ise/Coaching_TimeWasting
ex:Coaching_TimeWasting rdf:type owl:NamedIndividual ,
                                 ex:CoachInstructions ;
                        rdfs:label "Установка: Тянуть время"@ru .


###  http://example.org/football-ise/Coaching_UseWingers
ex:Coaching_UseWingers rdf:type owl:NamedIndividual ,
                                ex:CoachInstructions ;
                       ex:influence ex:Dec_8 ;
                       rdfs:label "Установка: Задействовать крайних"@ru .


###  http://example.org/football-ise/CornerArea
ex:CornerArea rdf:type owl:NamedIndividual ,
                       ex:Zone ;
              rdfs:label "Угловая зона"@ru .


###  http://example.org/football-ise/CornerRule
ex:CornerRule rdf:type owl:NamedIndividual ,
                       ex:Constraint ;
              ex:hasConstraintType ex:BoundaryType ;
              ex:constraintSeverity 0.4 ;
              rdfs:label "Правило углового"@ru .


###  http://example.org/football-ise/CounterAttack
ex:CounterAttack rdf:type owl:NamedIndividual ,
                          ex:Phase ;
                 rdfs:label "Контратака"@ru .


###  http://example.org/football-ise/CounterPress
ex:CounterPress rdf:type owl:NamedIndividual ,
                         ex:Phase ;
                rdfs:label "Контрпрессинг"@ru .


###  http://example.org/football-ise/Cross
ex:Cross rdf:type owl:NamedIndividual ,
                  ex:ActionOption ,
                  ex:OffsideConstrainedAction ;
         ex:hasActionType ex:PassType ;
         ex:limitedBy ex:OffsideRule ;
         rdfs:label "Навес"@ru .


###  http://example.org/football-ise/CrowdedSpace
ex:CrowdedSpace rdf:type owl:NamedIndividual ,
                         ex:SpaceAvailability ;
